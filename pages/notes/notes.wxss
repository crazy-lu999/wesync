/* pages/notes/notes.wxss */
.page { min-height: 100vh; background: #FFF8F4; padding: 24rpx 24rpx 60rpx; }

.loading-box { display: flex; align-items: center; justify-content: center; padding: 120rpx 0; }
.spinner {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  border: 6rpx solid #FFD9C8; border-top-color: #FF7A59;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.muted { color: #A09B98; }

.head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.head-title { font-size: 36rpx; font-weight: 800; color: #4A3F3B; }
.head-sub { font-size: 23rpx; margin-top: 6rpx; }
.compose-btn {
  font-size: 26rpx; font-weight: 700; color: #fff;
  background: #FF7A59; padding: 14rpx 26rpx; border-radius: 999rpx;
  box-shadow: 0 6rpx 14rpx rgba(255, 122, 89, 0.3);
}
.compose-btn.active { background: #C8C2BF; }

.composer {
  background: #fff; border-radius: 18rpx; padding: 24rpx;
  border: 1rpx solid rgba(255, 122, 89, 0.25);
  box-shadow: 0 8rpx 18rpx rgba(200, 120, 60, 0.10);
  margin-bottom: 24rpx;
}
.composer-input { width: 100%; min-height: 120rpx; font-size: 28rpx; line-height: 1.6; color: #4A3F3B; }
.composer-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; }
.counter { font-size: 23rpx; }
.save-btn {
  font-size: 28rpx; font-weight: 700; color: #fff;
  background: #FF7A59; padding: 12rpx 40rpx; border-radius: 999rpx;
}

.empty { text-align: center; padding: 140rpx 0; }
.empty-emoji { font-size: 80rpx; margin-bottom: 20rpx; }
.empty .muted { font-size: 28rpx; }

.note-list { display: flex; flex-direction: column; gap: 20rpx; }
.note-card {
  background: #fff; border-radius: 18rpx; padding: 26rpx 28rpx;
  border: 1rpx solid rgba(255, 122, 89, 0.16);
  box-shadow: 0 6rpx 16rpx rgba(200, 120, 60, 0.08);
}
.note-card-hover { opacity: 0.9; transform: scale(0.995); }
.note-content { font-size: 29rpx; line-height: 1.65; color: #4A3F3B; word-break: break-all; white-space: pre-wrap; }
.note-meta { display: flex; align-items: center; margin-top: 16rpx; font-size: 23rpx; }
.note-meta .from { margin-left: 4rpx; }
.hint { text-align: center; font-size: 22rpx; margin-top: 28rpx; }