/* pages/wall/wall.wxss — 意见反馈（私密通道）*/
.page {
  min-height: 100vh;
  padding: 20rpx 24rpx 80rpx;
  box-sizing: border-box;
  background: #F6F5F2;
}

.muted { color: #8C8784; font-size: 24rpx; }

.hero-strip {
  margin-bottom: 20rpx;
  padding: 16rpx 24rpx;
  background: #FFF4EE;
  color: #B07056;
  font-size: 24rpx;
  line-height: 1.6;
  border-radius: 16rpx;
  text-align: center;
}

.feedback-card {
  background: #fff;
  border-radius: 22rpx;
  padding: 26rpx;
  box-shadow: 0 2rpx 12rpx rgba(80, 40, 20, 0.04);
}

.card-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #2A2626;
  margin-bottom: 20rpx;
}
.card-title-icon { font-size: 30rpx; }

.feedback-input {
  width: 100%;
  min-height: 240rpx;
  padding: 24rpx;
  box-sizing: border-box;
  background: #F7F5F4;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #2A2626;
}
.feedback-ph { color: #C4BFBC; }
.feedback-meta { margin-top: 12rpx; text-align: right; font-size: 22rpx; }

.feedback-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 20rpx;
}
.save-btn {
  background: #FF6F5E;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 40rpx;
  border-radius: 999rpx;
}
.save-btn.busy { opacity: 0.6; }

.privacy-note {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.6;
}
