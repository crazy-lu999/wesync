<!--pages/wall/wall.wxml — 意见反馈（私密，仅开发者可见）-->
<view class="page">

  <view class="hero-strip">有想法、想要的功能，都可以悄悄告诉我们 💛</view>

  <view class="card feedback-card">
    <view class="card-title">
      <text class="card-title-icon">💬</text>
      <text>意见反馈</text>
    </view>
    <textarea
      class="feedback-input"
      value="{{input}}"
      maxlength="{{max}}"
      placeholder="写下你遇到的问题或想要的功能…"
      placeholder-class="feedback-ph"
      auto-height
      show-confirm-bar="{{false}}"
      bindinput="onInput"
    ></textarea>
    <view class="feedback-meta muted">{{input.length}}/{{max}}</view>
    <view class="feedback-actions">
      <view class="save-btn {{submitting ? 'busy' : ''}}" bindtap="onSubmit">发送想法</view>
    </view>
  </view>

  <view class="privacy-note muted">不用留手机号、住址这些隐私信息哦～</view>
</view>
