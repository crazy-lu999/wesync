/* pages/releaseNotes/releaseNotes.wxss — 更新日志 */
.page {
  min-height: 100vh;
  padding: 20rpx 0 60rpx;
  box-sizing: border-box;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 44rpx 40rpx;
  margin: 24rpx;
  text-align: center;
  background: linear-gradient(135deg, #FFF4EE 0%, #FFFFFF 70%);
}
.hero-emoji { font-size: 64rpx; line-height: 1; }
.hero-title { font-size: 38rpx; font-weight: 800; color: #2A2626; }
.hero-sub { font-size: 24rpx; }

.loading, .empty { text-align: center; padding: 64rpx 0; font-size: 26rpx; }

.release-card { margin: 20rpx 24rpx; padding: 30rpx 32rpx; }
.release-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}
.ver-badge {
  flex: none;
  font-size: 22rpx;
  font-weight: 700;
  color: #FF6F5E;
  background: #FFF1EC;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}
.release-title { font-size: 30rpx; font-weight: 700; color: #2A2626; }
.release-date { margin-left: auto; font-size: 22rpx; }

.release-notes { margin-top: 18rpx; display: flex; flex-direction: column; gap: 12rpx; }
.note-row { display: flex; align-items: flex-start; gap: 12rpx; }
.note-dot { flex: none; color: #FF9A86; font-size: 28rpx; line-height: 1.5; }
.note-text { font-size: 28rpx; line-height: 1.6; color: #4A4543; }

.foot { text-align: center; font-size: 22rpx; padding: 28rpx 0; }
