<!--pages/index/index.wxml-->
<view class="page">

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading">
    <view class="spinner"></view>
  </view>

  <!-- 无家庭：引导 -->
  <view wx:elif="{{!hasFamily}}" class="guide">
    <view class="guide-emoji">🏡</view>
    <view class="guide-title">建立一个你们的小家</view>
    <view class="guide-sub muted">创建家庭后把邀请码发给另一半，<br/>两人就能共享同一个待办清单啦</view>
    <button class="btn-primary guide-btn" bindtap="goCreate">创建家庭</button>
    <button class="btn-ghost guide-btn" bindtap="goJoin">我有邀请码，加入</button>
  </view>

  <!-- 有家庭：列表 -->
  <view wx:else class="list-wrap">
    <view class="topbar">
      <view class="family-name">
        <view class="fam-dot">🏠</view>
        <text>{{family.name}}</text>
      </view>
      <view class="me-btn" bindtap="goMe">
        <text>我的</text>
        <text class="chev">›</text>
      </view>
    </view>

    <view class="stat">
      <view class="stat-item">
        <view class="stat-num brand">{{activeCount}}</view>
        <view class="stat-label">待办</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-num">{{doneCount}}</view>
        <view class="stat-label">已完成</view>
      </view>
    </view>

    <view wx:if="{{todosReady && todos.length === 0}}" class="empty">
      <view class="empty-emoji">📝</view>
      <view class="muted">还没有待办，加一条吧</view>
    </view>

    <view wx:else class="todo-list">
      <view
        wx:for="{{todos}}"
        wx:key="_id"
        class="todo-item {{item.done ? 'done' : ''}}"
        data-id="{{item._id}}"
        data-index="{{index}}"
        bindlongpress="onLongPress"
      >
        <view
          class="checkbox {{item.done ? 'checked' : ''}}"
          data-id="{{item._id}}"
          data-index="{{index}}"
          catchtap="onToggle"
        >
          <text class="check-mark" wx:if="{{item.done}}">✓</text>
        </view>
        <view class="todo-main">
          <view class="todo-content">{{item.content}}</view>
          <view class="todo-meta">
            <text class="creator {{item.mine ? 'mine' : ''}}">{{item.creatorNick}}</text>
            <text class="muted">{{item.timeText}}</text>
            <text wx:if="{{item.remindText}}" class="remind-tag">{{item.remindText}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="sync-tip {{subscribing ? 'on' : ''}}">
      <block wx:if="{{!subscribing}}">
        <text class="sync-dot gray">●</text> 正在连接…
      </block>
      <block wx:elif="{{syncMode === 'realtime'}}">
        <text class="sync-dot green">●</text> 实时同步中，对方改动即时可见
      </block>
      <block wx:else>
        <text class="sync-dot amber">●</text> 已同步 · 对方改动约几秒内出现
      </block>
    </view>
  </view>

  <!-- 底部输入栏（仅在有家庭时显示） -->
  <view wx:if="{{hasFamily}}" class="input-wrap">
    <!-- 提醒时间选择条：开启提醒后展开 -->
    <view wx:if="{{remindOn}}" class="remind-row">
      <text class="remind-label">🔔 提醒我</text>
      <picker mode="date" value="{{remindDate}}" start="{{remindDate}}" bindchange="onRemindDateChange">
        <view class="remind-pick">{{remindDate}}</view>
      </picker>
      <text class="remind-sep">·</text>
      <picker mode="time" value="{{remindTime}}" bindchange="onRemindTimeChange">
        <view class="remind-pick">{{remindTime}}</view>
      </picker>
    </view>
    <view class="input-bar">
      <button class="remind-chip {{remindOn ? 'on' : ''}}" bindtap="toggleRemind">🔔</button>
      <input
        class="input-line {{editing ? 'editing' : ''}}"
        placeholder="{{editing ? '修改这条待办…' : '记一笔家庭待办…'}}"
        value="{{inputVal}}"
        focus="{{inputFocus}}"
        confirm-type="done"
        bindinput="onInput"
        bindconfirm="onAdd"
      />
      <button wx:if="{{editing}}" class="edit-cancel" bindtap="cancelEdit">取消</button>
      <button class="add-btn {{editing ? 'edit' : ''}} {{inputVal ? '' : 'disable'}}" bindtap="onAdd">{{editing ? '保存' : '添加'}}</button>
    </view>
  </view>

  <!-- 长按操作面板：底部弹出的精美菜单 -->
  <view wx:if="{{menuVisible}}" class="sheet-mask" catchtap="closeMenu" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet-handle"></view>

      <!-- 第 1 步：选择操作 -->
      <block wx:if="{{!confirmDelete}}">
        <view class="sheet-title">要做什么？</view>
        <view class="sheet-item" hover-class="sheet-item-hover" bindtap="onMenuEdit">
          <text class="sheet-emoji">✏️</text>
          <text class="sheet-label">编辑这条待办</text>
        </view>
        <view class="sheet-divider"></view>
        <view class="sheet-item danger" hover-class="sheet-item-hover" bindtap="onMenuDelete">
          <text class="sheet-emoji">🗑️</text>
          <text class="sheet-label">删除</text>
        </view>
      </block>

      <!-- 第 2 步：删除确认 -->
      <block wx:else>
        <view class="sheet-title">确定要删除吗？</view>
        <view class="del-preview">
          <text class="del-preview-dot">🗑️</text>
          <text class="del-preview-text">{{menuContent}}</text>
        </view>
        <view class="del-actions">
          <button class="del-btn cancel" hover-class="sheet-item-hover" bindtap="closeMenu">再想想</button>
          <button class="del-btn go" hover-class="del-go-hover" bindtap="confirmRemove">删除</button>
        </view>
      </block>
    </view>
  </view>

</view>