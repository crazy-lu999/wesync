<!--pages/index/index.wxml-->
<view class="page">

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading">
    <view class="spinner"></view>
  </view>

  <!-- 无家庭：引导 -->
  <view wx:elif="{{!hasFamily}}" class="guide">
    <view class="guide-emoji">🏡</view>
    <view class="guide-title">建立一个你们的小家</view>
    <view class="guide-sub muted">创建家庭后把邀请码发给另一半，<br/>两人就能共享同一个待办清单啦</view>
    <button class="btn-primary guide-btn" bindtap="goCreate">创建家庭</button>
    <button class="btn-ghost guide-btn" bindtap="goJoin">我有邀请码，加入</button>
  </view>

  <!-- 有家庭：列表 -->
  <view wx:else class="list-wrap">
    <!-- 新版本提醒横幅（热启动也能看到） -->
    <view wx:if="{{showUpdateBanner}}" class="update-banner" bindtap="onRestart2Update" hover-class="update-banner-hover">
      <text class="update-banner-emoji">🎁</text>
      <text class="update-banner-text">我藏了个新功能，
快重启去拆礼物吧 ❤️</text>
      <text class="update-banner-arrow">›</text>
    </view>
    <!-- 语义化同步事件提示条 -->
    <view wx:if="{{syncTip}}" class="sync-event-tip">{{syncTip}}</view>

    <!-- 离线/云端异常：本地缓存兜底提示，点击重试 -->
    <view wx:if="{{offline}}" class="offline-banner" bindtap="onRetryLoad" hover-class="offline-banner-hover">
      <text class="offline-emoji">⚠️</text>
      <text class="offline-text">网络开小差，以下为本地缓存。点我重试</text>
      <text class="offline-arrow">↻</text>
    </view>

    <!-- 亲密卡：每天一句窝心话 + 纪念日；右上角是「我的」入口（不占独立行） -->
    <view class="warm-card">
      <view class="warm-art">
        <view class="warm-bubble">💌</view>
      </view>
      <view class="warm-body">
        <view class="warm-phrase">{{dailyPhrase}}</view>
        <!-- 倒计时：距离 X 还有 N 天 -->
        <view wx:if="{{annivInfo.nextLabel}}" class="warm-next-line">💍 {{annivInfo.nextLabel}}</view>
        <view wx:else class="warm-next-line link" bindtap="goMe">记下纪念日 🤍</view>
      </view>
      <view class="wall-btn" bindtap="goWall">建议墙</view>
    </view>

    <view class="stat">
      <view class="stat-item">
        <view class="stat-num brand">{{activeCount}}</view>
        <view class="stat-label">待办</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-num">{{doneCount}}</view>
        <view class="stat-label">已完成</view>
      </view>
    </view>

    <view class="stat-sub">
      <text class="stat-total">🎯 共完成 {{totalDone}} 件 · 本周 {{weeklyDone}} 件</text>
      <text wx:if="{{doneCount}}" class="clear-done" bindtap="onClearDone">清空已完成</text>
    </view>

    <view wx:if="{{todosReady && todos.length === 0}}" class="empty">
      <view class="empty-emoji">📝</view>
      <view class="muted">还没有待办，加一条吧</view>
      <view class="tpl-title muted">不想想？挑一个 👇</view>
      <view class="tpl-list">
        <view
          class="tpl-chip"
          wx:for="{{templates}}"
          wx:key="*this"
          bindtap="useTemplate"
          data-content="{{item}}"
        >{{item}}</view>
      </view>
    </view>

    <view wx:else class="todo-list">
      <view
        wx:for="{{todos}}"
        wx:key="_id"
        class="todo-item {{item.done ? 'done' : ''}}"
        data-id="{{item._id}}"
        data-index="{{index}}"
        bindlongpress="onTodoLongPress"
        hover-class="todo-hover"
      >
        <view
          class="checkbox {{item.done ? 'checked' : ''}}"
          data-id="{{item._id}}"
          data-index="{{index}}"
          catchtap="onToggle"
        >
          <text class="check-mark" wx:if="{{item.done}}">✓</text>
        </view>
        <view class="todo-main">
          <view class="todo-line">
            <text wx:if="{{item.important && !item.done}}" class="imp-star">⭐</text>
            <view class="todo-content">{{item.content}}</view>
          </view>
          <view class="todo-meta">
            <text class="creator {{item.mine ? 'mine' : ''}}">{{item.creatorNick}}</text>
            <text wx:if="{{item.assignee}}" class="assign-tag {{item.assignToMe ? 'mine' : ''}}">👤 {{item.assignNick}}</text>
            <text wx:if="{{item.done}}" class="meta-done">✓ {{item.doneNick || '已完成'}}</text>
            <text class="muted">{{item.done && item.doneTimeText ? item.doneTimeText : item.timeText}}</text>
            <!-- 截止日期倒计时徽标（跟在创建人/时间后面） -->
            <view wx:if="{{item.dayInfo && !item.done}}" class="cd-badge {{item.dayInfo.state}}">
              <text class="cd-label">⏰ {{item.dayInfo.label}}</text>
              <text class="cd-text">{{item.dayInfo.text}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="sync-tip {{subscribing ? 'on' : ''}}">
      <block wx:if="{{!subscribing}}">
        <text class="sync-dot gray">●</text> 正在连接…
      </block>
      <block wx:elif="{{syncMode === 'realtime'}}">
        <text class="sync-dot green">●</text> 实时同步中，对方改动即时可见
      </block>
      <block wx:else>
        <text class="sync-dot amber">●</text> 已同步 · 对方改动约几秒内出现
      </block>
    </view>
  </view>

  <!-- 撤销提示条：删除/清空后 5 秒内可撤回 -->
  <view wx:if="{{undoLabel}}" class="undo-bar">
    <text class="undo-text">{{undoLabel}}</text>
    <view class="undo-btn" bindtap="onUndo" hover-class="undo-btn-hover">撤销</view>
  </view>

  <!-- 底部输入栏（仅在有家庭时显示） -->
  <view wx:if="{{hasFamily}}" class="input-wrap {{editing ? 'editing' : ''}}">
    <!-- 编辑态：完整面板，展示原内容 + 输入框 + 操作按钮，不再和按钮挤在一行 -->
    <block wx:if="{{editing}}">
      <view class="edit-panel">
        <view class="edit-head">
          <text class="edit-title">编辑待办</text>
          <view class="edit-close" bindtap="cancelEdit">✕</view>
        </view>
        <textarea
          class="input-line editing"
          placeholder="记一笔家庭待办…"
          value="{{inputVal}}"
          focus="{{inputFocus}}"
          auto-height
          maxlength="140"
          cursor-spacing="140"
          bindinput="onInput"
        ></textarea>
        <!-- 编辑态：截止日期 -->
        <picker mode="date" value="{{today}}" start="{{today}}" bindchange="onPickDeadline" class="cd-picker">
          <view class="cd-chip wide {{inputDeadline ? 'set' : ''}}">
            <block wx:if="{{inputDeadline}}">
              <text class="cd-chip-set">⏰ {{inputDeadlineText}}</text>
              <text class="cd-chip-x" catchtap="onClearDeadline">✕</text>
            </block>
            <text wx:else>⏰ 倒计时</text>
          </view>
        </picker>
        <view class="edit-actions">
          <button class="edit-cancel" bindtap="cancelEdit">取消</button>
          <button class="add-btn edit {{inputVal ? '' : 'disable'}}" bindtap="onAdd">保存</button>
        </view>
      </view>
    </block>
    <!-- 普通态：单行输入 + 添加 -->
    <block wx:else>
      <view class="input-bar">
        <textarea
          class="input-line"
          placeholder="记一笔家庭待办…"
          value="{{inputVal}}"
          focus="{{inputFocus}}"
          auto-height
          maxlength="140"
          cursor-spacing="140"
          bindinput="onInput"
        ></textarea>
        <!-- 新建态：截止日期（有输入内容时作为可选项出现，用户自选） -->
        <picker wx:if="{{inputVal}}" mode="date" value="{{today}}" start="{{today}}" bindchange="onPickDeadline" class="cd-picker">
          <view class="cd-chip {{inputDeadline ? 'set' : ''}}">
            <block wx:if="{{inputDeadline}}">
              <text class="cd-chip-set">⏰ {{inputDeadlineText}}</text>
              <text class="cd-chip-x" catchtap="onClearDeadline">✕</text>
            </block>
            <text wx:else>⏰ 倒计时</text>
          </view>
        </picker>
        <!-- 新建态：指派给谁 chip -->
        <view wx:if="{{inputVal}}" class="assign-chip {{assignFor ? 'set' : ''}}" bindtap="onPickAssign" hover-class="assign-hover">{{assignForText}}</view>
        <button class="add-btn {{inputVal ? '' : 'disable'}}" bindtap="onAdd">添加</button>
      </view>
    </block>
  </view>

  <!-- 撒花庆祝动画（全屏，非阻塞） -->
  <view wx:if="{{celebrate}}" class="celebrate-mask" catchtouchmove="noop">
    <view
      wx:for="{{petals}}"
      wx:key="index"
      class="petal"
      style="left:{{item.left}}%; font-size:{{item.size}}rpx; width:{{item.size}}rpx; height:{{item.size}}rpx; animation-duration:{{item.dur}}s; animation-delay:{{item.delay}}s; --drift:{{item.drift}}rpx; --rot:{{item.rotStart}}deg;"
    >{{item.emoji}}</view>
  </view>

  <!-- 整屏右下角悬浮「我的」入口（类似刷新悬浮钮） -->
  <view wx:if="{{hasFamily}}" class="my-fab" bindtap="goMe" hover-class="my-fab-hover">
    <view class="my-fab-heart">♥</view>
    <view class="my-fab-icon">🏠</view>
    <view class="my-fab-label">小家</view>
  </view>

</view>