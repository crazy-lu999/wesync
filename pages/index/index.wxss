/* pages/index/index.wxss */
.page { padding-bottom: 160rpx; }

.loading { padding: 200rpx 0; text-align: center; color: #999; }

/* 引导页 */
.guide {
  display: flex; flex-direction: column; align-items: center;
  padding: 180rpx 64rpx 0;
}
.guide-emoji { font-size: 140rpx; margin-bottom: 32rpx; }
.guide-title { font-size: 40rpx; font-weight: 600; margin-bottom: 16rpx; }
.guide-sub { text-align: center; line-height: 1.6; margin-bottom: 64rpx; }
.guide-btn { width: 100%; margin-bottom: 24rpx; }

/* 顶部 */
.topbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 32rpx 8rpx;
}
.family-name { font-size: 36rpx; font-weight: 600; }
.me-btn { color: #FF7A59; font-size: 28rpx; }
.stat { padding: 4rpx 32rpx 16rpx; font-size: 26rpx; color: #666; }

/* 空态 */
.empty {
  display: flex; flex-direction: column; align-items: center;
  padding: 120rpx 0;
}
.empty-emoji { font-size: 96rpx; margin-bottom: 16rpx; }

/* 列表 */
.todo-list { padding: 0 24rpx; }
.todo-item {
  display: flex; align-items: flex-start;
  background: #fff; border-radius: 20rpx;
  padding: 28rpx 24rpx; margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}
.todo-item.done { opacity: 0.55; }
.checkbox {
  flex: none; width: 44rpx; height: 44rpx; border-radius: 50%;
  border: 4rpx solid #ddd; color: transparent;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; margin-right: 20rpx; margin-top: 2rpx;
}
.checkbox.checked { background: #FF7A59; border-color: #FF7A59; color: #fff; }
.todo-main { flex: 1; min-width: 0; }
.todo-content { font-size: 32rpx; line-height: 1.5; word-break: break-word; }
.todo-item.done .todo-content { text-decoration: line-through; color: #999; }
.todo-meta { margin-top: 10rpx; font-size: 24rpx; display: flex; gap: 16rpx; align-items: center; }
.creator {
  background: #f0f0f3; color: #888; padding: 2rpx 14rpx; border-radius: 999rpx;
}
.creator.mine { background: #ffe7df; color: #FF7A59; }

/* 同步提示 */
.sync-tip {
  text-align: center; font-size: 22rpx; color: #aaa; padding: 16rpx 0 8rpx;
}
.sync-tip.on { color: #52c41a; }

/* 输入栏 */
.input-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; align-items: center; gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff; border-top: 2rpx solid #f0f0f0;
}
.input-bar .input-line { flex: 1; }
.add-btn {
  flex: none; background: #FF7A59; color: #fff;
  border-radius: 999rpx; height: 80rpx; line-height: 80rpx;
  padding: 0 36rpx; font-size: 30rpx;
}
.add-btn.disable { background: #ffd2c5; }
