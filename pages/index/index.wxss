/* pages/index/index.wxss */
.page { padding-bottom: 200rpx; }

/* 加载中 spinner */
.loading { padding: 260rpx 0; text-align: center; }
.spinner {
  width: 64rpx; height: 64rpx; margin: 0 auto;
  border: 6rpx solid #ffd9cf;
  border-top-color: #FF6F5E; border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* 引导页 */
.guide {
  display: flex; flex-direction: column; align-items: center;
  padding: 200rpx 64rpx 0;
}
.guide-emoji {
  font-size: 150rpx; margin-bottom: 40rpx;
  filter: drop-shadow(0 16rpx 24rpx rgba(255, 111, 94, 0.25));
}
.guide-title { font-size: 42rpx; font-weight: 700; margin-bottom: 20rpx; letter-spacing: 1rpx; }
.guide-sub { text-align: center; line-height: 1.7; margin-bottom: 72rpx; }
.guide-btn { width: 100%; margin-bottom: 28rpx; }

/* 顶部 */
.topbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 40rpx 36rpx 24rpx;
}
.family-name {
  display: flex; align-items: center; gap: 14rpx;
  font-size: 38rpx; font-weight: 800; color: #2A2626;
}
.fam-dot {
  width: 56rpx; height: 56rpx; border-radius: 18rpx;
  background: linear-gradient(135deg, #FF6F5E, #FF917A);
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; box-shadow: 0 8rpx 16rpx rgba(255, 111, 94, 0.28);
}
.me-btn {
  display: flex; align-items: center; gap: 6rpx;
  color: #FF6F5E; font-size: 28rpx; font-weight: 600;
  background: #fff; padding: 12rpx 24rpx; border-radius: 999rpx;
  box-shadow: 0 6rpx 18rpx rgba(80, 40, 20, 0.06);
}

/* 家庭名编辑 */
.family-name.fam-editing {
  flex: 1; margin-right: 16rpx; min-width: 0;
}
.fam-name-input {
  flex: 1; min-width: 0; height: 56rpx; line-height: 56rpx;
  padding: 0 16rpx;
  border: 2rpx solid rgba(255, 111, 94, 0.4); border-radius: 12rpx;
  background: #FFF6F3; font-size: 30rpx; font-weight: 600; color: #2A2626;
}
.fam-name-actions {
  display: flex; align-items: center; gap: 6rpx; margin-left: 12rpx;
}
.fam-action-cancel {
  color: #B8B2AF; font-size: 24rpx; font-weight: 600; padding: 8rpx 6rpx;
}
.fam-action-save {
  color: #fff; font-size: 24rpx; font-weight: 600;
  background: #FF6F5E; border-radius: 999rpx; padding: 10rpx 22rpx;
  box-shadow: 0 6rpx 12rpx rgba(255, 111, 94, 0.28);
}
.fam-hover { opacity: 0.72; }

.chev { font-size: 34rpx; line-height: 1; }

/* 统计卡 */
.stat {
  display: flex; align-items: center; justify-content: center; gap: 48rpx;
  background: #fff; margin: 0 24rpx 28rpx; padding: 28rpx 0;
  border-radius: 24rpx; box-shadow: 0 8rpx 28rpx rgba(80, 40, 20, 0.05);
}
.stat-item { display: flex; flex-direction: column; align-items: center; min-width: 140rpx; }
.stat-num { font-size: 46rpx; font-weight: 800; line-height: 1.2; }
.stat-label { font-size: 24rpx; color: #A09B98; margin-top: 4rpx; }
.stat-divider { width: 1rpx; height: 64rpx; background: #F0ECEA; }

/* 空态 */
.empty {
  display: flex; flex-direction: column; align-items: center;
  padding: 140rpx 0;
}
.empty-emoji {
  font-size: 100rpx; margin-bottom: 20rpx;
  filter: drop-shadow(0 10rpx 18rpx rgba(80, 40, 20, 0.12));
}

/* 顶部语义化同步事件提示条 */
.sync-event-tip {
  position: sticky; top: 0; z-index: 20;
  background: linear-gradient(135deg, #FF6F5E, #FF917A); color: #fff;
  font-size: 26rpx; font-weight: 600;
  padding: 20rpx 28rpx; margin: 16rpx 24rpx 0;
  border-radius: 18rpx; text-align: center;
  box-shadow: 0 10rpx 22rpx rgba(255, 111, 94, 0.32);
  animation: tipIn 0.3s ease;
}
@keyframes tipIn { from { transform: translateY(-12rpx); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

/* 统计栏下方：一起完成件数 + 清空已完成 */
.stat-sub {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 24rpx 8rpx; margin-top: 8rpx;
}
.stat-total { font-size: 24rpx; color: #A09B98; }
.clear-done {
  font-size: 24rpx; color: #FF6F5E; font-weight: 600;
  padding: 6rpx 18rpx; border-radius: 999rpx; border: 1rpx solid rgba(255, 111, 94, 0.35);
}
.clear-done:active { background: #FFEFEA; }

/* 空态示例模板 */
.tpl-title { margin-top: 36rpx; font-size: 24rpx; }
.tpl-list { display: flex; flex-wrap: wrap; justify-content: center; gap: 16rpx; margin-top: 20rpx; }
.tpl-chip {
  font-size: 26rpx; color: #FF6F5E; background: #FFF0EC;
  padding: 14rpx 26rpx; border-radius: 999rpx;
  box-shadow: 0 4rpx 10rpx rgba(80, 40, 20, 0.06);
}
.tpl-chip:active { background: #FFE3DC; }

/* 待办正文行：重要星标 + 内容 */
.todo-line { display: flex; align-items: flex-start; }
.imp-star { flex: none; font-size: 28rpx; margin-right: 8rpx; line-height: 1.5; }
.meta-done { color: #52C41A; font-weight: 600; }

/* 截止日期倒计时徽标（位于 todo-meta 行内，与创建人/时间同行） */
.cd-badge {
  display: inline-flex; align-items: center; gap: 8rpx;
  font-size: 20rpx; font-weight: 600;
  padding: 4rpx 14rpx; border-radius: 999rpx; width: fit-content;
  line-height: 1.3;
}
.cd-label { font-weight: 600; }
.cd-badge.normal { background: #F4F2F1; color: #8C8784; }
.cd-badge.soon {
  background: #FFEEDC; color: #E8851A;
}
.cd-badge.today {
  background: linear-gradient(135deg, #FF6F5E, #FF917A); color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(255, 111, 94, 0.35);
  animation: cdPulse 1.4s ease-in-out infinite;
}
.cd-badge.past { background: #F1EFEE; color: #B8B2AF; text-decoration: line-through; }
@keyframes cdPulse {
  0%, 100% { transform: scale(1); box-shadow: 0 6rpx 16rpx rgba(255, 111, 94, 0.35); }
  50% { transform: scale(1.06); box-shadow: 0 8rpx 24rpx rgba(255, 111, 94, 0.5); }
}

/* 底部输入栏的日期选择 chip */
.cd-picker { flex: none; }
.cd-chip {
  flex: none; height: 60rpx; line-height: 60rpx; box-sizing: border-box;
  padding: 0 16rpx; border-radius: 999rpx; font-size: 23rpx; font-weight: 600;
  background: #F4F2F1; color: #8C8784; white-space: nowrap;
  display: flex; align-items: center; gap: 8rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}
.cd-chip.set { background: #FFEFEA; color: #FF6F5E; border-color: rgba(255, 111, 94, 0.3); }
.cd-chip.wide { height: 76rpx; line-height: 76rpx; padding: 0 24rpx; font-size: 26rpx; }
.cd-chip-set { font-size: 23rpx; }
.cd-chip-x {
  font-size: 24rpx; font-weight: 700; opacity: 0.75;
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: rgba(255, 111, 94, 0.15);
  display: flex; align-items: center; justify-content: center;
}
.cd-chip-x:active { background: rgba(255, 111, 94, 0.3); }

/* 底部撤销提示条 */
.undo-bar {
  position: fixed; left: 50%; transform: translateX(-50%);
  bottom: 150rpx; z-index: 60;
  display: flex; align-items: center; gap: 20rpx;
  background: rgba(42, 38, 38, 0.92); color: #fff;
  padding: 20rpx 30rpx; border-radius: 999rpx;
  box-shadow: 0 14rpx 34rpx rgba(0, 0, 0, 0.28);
  max-width: 90%; width: max-content;
  animation: undoIn 0.25s ease;
}
@keyframes undoIn { from { transform: translateX(-50%) translateY(16rpx); opacity: 0; } to { transform: translateX(-50%) translateY(0); opacity: 1; } }
.undo-text {
  font-size: 26rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  max-width: 420rpx;
}
.undo-btn {
  font-size: 26rpx; font-weight: 700; color: #FF917A;
  padding: 6rpx 10rpx;
}
.undo-btn-hover { opacity: 0.6; }

/* 列表 */
.todo-list { padding: 0 24rpx; }
.todo-item {
  display: flex; align-items: flex-start;
  background: #fff; border-radius: 24rpx;
  padding: 30rpx 28rpx; margin-bottom: 18rpx;
  box-shadow: 0 8rpx 26rpx rgba(80, 40, 20, 0.05);
  border: 1rpx solid rgba(255, 117, 95, 0.05);
  transition: opacity 0.2s, transform 0.1s;
}
.todo-item:active { transform: scale(0.99); }
.todo-item.done {
  opacity: 0.6;
  animation: doneSettle 0.5s ease;
}
/* 完成过渡：整卡轻微缩放并沉到半透明 */
@keyframes doneSettle {
  0%   { opacity: 1; transform: scale(1); }
  35%  { transform: scale(0.97); }
  100% { opacity: 0.6; transform: scale(1); }
}

.checkbox {
  flex: none; width: 48rpx; height: 48rpx; border-radius: 50%;
  background: #F4F2F1; color: #fff;
  display: flex; align-items: center; justify-content: center;
  margin-right: 22rpx; margin-top: 2rpx;
  border: none; overflow: hidden;
}
.check-mark { font-size: 28rpx; font-weight: 800; }
.checkbox.checked {
  background: linear-gradient(135deg, #FF6F5E, #FF917A);
  box-shadow: 0 6rpx 14rpx rgba(255, 111, 94, 0.35);
}
/* 勾选对勾弹出 */
.checkbox.checked .check-mark { animation: checkPop 0.35s ease; }
@keyframes checkPop {
  0%   { transform: scale(0); }
  60%  { transform: scale(1.35); }
  100% { transform: scale(1); }
}

.todo-main { flex: 1; min-width: 0; }
.todo-content { position: relative; width: fit-content; font-size: 32rpx; line-height: 1.5; word-break: break-word; font-weight: 500; }
/* 已完成正文：删除线从左到右划出 */
.todo-item.done .todo-content { text-decoration: none; color: #B8B2AF; }
.todo-item.done .todo-content::after {
  content: "";
  position: absolute; left: 0; top: 52%;
  width: 100%; height: 3rpx; background: #B8B2AF; border-radius: 2rpx;
  transform: scaleX(0); transform-origin: left center;
  animation: strike 0.4s ease forwards;
}
@keyframes strike { from { transform: scaleX(0); } to { transform: scaleX(1); } }
.todo-meta {
  margin-top: 12rpx; font-size: 24rpx; gap: 16rpx;
  display: flex; align-items: center; flex-wrap: wrap; row-gap: 10rpx;
  color: #A09B98;
}
.creator {
  background: #F4F2F1; color: #8C8784; padding: 4rpx 18rpx; border-radius: 999rpx;
  font-size: 22rpx; font-weight: 500;
}
.creator.mine { background: #FFEFEA; color: #FF6F5E; }

/* 长按待办提示点击态 */
.todo-item.todo-hover { background: #FBF7F6; }

/* 撒花庆祝动画 */
.celebrate-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  z-index: 999;
  overflow: hidden;
  pointer-events: none;
  background: transparent;
}
.petal {
  position: absolute; bottom: -60rpx;
  line-height: 1;
  /* 用 CSS 变量控制漂移与旋转，keyframes 里引用 */
  --drift: 0rpx; --rot: 0deg;
  animation-name: petalFloat;
  animation-timing-function: ease-in;
  animation-fill-mode: both;
}
@keyframes petalFloat {
  0% {
    transform: translateY(0) translateX(0) rotate(var(--rot)) scale(0.6);
    opacity: 0;
  }
  12% { opacity: 1; }
  50% { transform: translateY(-60vh) translateX(var(--drift)) rotate(calc(var(--rot) + 180deg)) scale(1); }
  100% {
    transform: translateY(-120vh) translateX(calc(var(--drift) * 1.4)) rotate(calc(var(--rot) + 360deg)) scale(0.9);
    opacity: 0;
  }
}

/* 同步提示 */
.sync-tip {
  text-align: center; font-size: 22rpx; color: #B8B2AF;
  padding: 20rpx 0 8rpx;
}.sync-dot { margin-right: 8rpx; }
.sync-dot.green { color: #52C41A; }
.sync-dot.gray { color: #C4BFBC; }
.sync-dot.amber { color: #FAAD14; }
.sync-tip.on { color: #8C8784; }

/* 输入栏：外层固定容器 + 内层输入条 */
.input-wrap {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 10;
  padding-bottom: env(safe-area-inset-bottom);
  background: linear-gradient(0deg, rgba(255,255,255,0.98) 75%, rgba(255,255,255,0) 100%);
  padding-top: 6rpx;
}
/* 编辑态：外层变成一张圆角卡片，顶部向上收口形成面板感 */
.input-wrap.editing {
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -12rpx 40rpx rgba(80, 40, 20, 0.14);
  padding-top: 0;
}

.input-bar {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: saturate(180%) blur(20rpx);
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}
/* 新建态日期 chip 紧跟输入框 */
.input-bar .cd-picker { margin-right: 4rpx; }

/* 编辑态面板：原内容 + 输入框 + 操作按钮纵向堆叠，输入框不再被按钮挤压 */
.edit-panel { padding: 28rpx 28rpx 24rpx; }
.edit-head {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 20rpx;
}
.edit-title { font-size: 34rpx; font-weight: 800; color: #2A2626; }
.edit-close {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: #F4F2F1; color: #8C8784;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx;
}
.edit-close:active { background: #ECE7E4; }

.input-bar .input-line { flex: 1; }
/* textarea 多行输入：给个最小高度不至于太扁，过长可自动增高至合理高度 */
.input-bar textarea.input-line {
  min-height: 48rpx;
  max-height: 220rpx;
  line-height: 1.5;
  box-sizing: border-box;
}
/* 编辑态输入框：通栏、带内边距，充分容纳修改内容 */
.edit-panel textarea.input-line {
  width: 100%; min-height: 96rpx; max-height: 300rpx;
  line-height: 1.5; box-sizing: border-box;
  background: #F7F5F4; border-radius: 16rpx;
  padding: 24rpx;
  font-size: 32rpx;
}
.edit-panel textarea.input-line.editing {
  border: 2rpx solid rgba(255, 111, 94, 0.4); background: #FFF6F3;
}
/* 编辑态日期行：换行显示，不与按钮挤行 */
.edit-panel .cd-picker { display: block; margin-top: 16rpx; }
.edit-panel .cd-chip.wide { width: fit-content; }

/* 编辑态操作按钮：取消 / 保存各占一半，不再挤压输入框 */
.edit-actions { display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; }
.edit-actions .edit-cancel { flex: 1; width: auto; padding: 0; height: 88rpx; }
.edit-actions .add-btn.edit { flex: 1; width: auto; padding: 0; height: 88rpx; }

.input-bar .input-line.editing { border-color: rgba(255, 111, 94, 0.4); background: #FFF6F3; }
.edit-cancel {
  flex: none; border: none; background: #F4F2F1; color: #8C8784;
  border-radius: 999rpx; height: 76rpx;
  display: flex; align-items: center; justify-content: center;
  line-height: 1; padding: 0 32rpx; font-size: 28rpx; font-weight: 500;
}
.edit-cancel::after { border: none; }
.add-btn {
  flex: none; color: #fff; border: none;
  border-radius: 48rpx; height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  line-height: 1; padding: 0 40rpx; font-size: 30rpx; font-weight: 600;
  background: linear-gradient(135deg, #FF6F5E, #FF917A);
  box-shadow: 0 8rpx 20rpx rgba(255, 111, 94, 0.3);
}
.add-btn::after { border: none; }
.add-btn.disable { background: #E8E3E0; color: #C4BFBC; box-shadow: none; }
.add-btn.edit { padding: 0 44rpx; }

/* 底部常态(新建)输入栏的添加按钮：紧凑小胶囊，不占宽；编辑态大按钮不受影响 */
.input-bar .add-btn {
  flex: 0 0 auto;
  width: auto;
  min-width: 0;
  max-width: 156rpx;
  height: 60rpx;
  padding: 0 24rpx;
  font-size: 25rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 12rpx rgba(255, 111, 94, 0.22);
  box-sizing: border-box;
}
