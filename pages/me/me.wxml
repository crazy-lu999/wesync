<!--pages/me/me.wxml-->
<view class="page">

  <!-- 首屏 loading 骨架 -->
  <block wx:if="{{loading}}">
    <view class="card skeleton-card">
      <view class="skeleton avatar-sk"></view>
      <view class="skeleton-lines">
        <view class="skeleton-line w55"></view>
        <view class="skeleton-line w75"></view>
        <view class="skeleton-line w40"></view>
      </view>
    </view>
    <view class="card skeleton-card">
      <view class="skeleton-line w70"></view>
      <view class="skeleton-line w85"></view>
    </view>
  </block>

  <block wx:elif="{{family}}">
    <!-- 相片墙卡：自定义上传照片展示（长按删除 / 点按查看） -->
    <view class="card">
      <view class="card-title">
        <text class="card-title-icon">📷</text>
        <block wx:if="{{editingWallTitle}}">
          <input
            class="wall-title-input"
            value="{{wallTitleInput}}"
            focus
            maxlength="12"
            bindinput="onWallTitleInput"
            bindconfirm="onSaveWallTitle"
            placeholder="给相片墙起个名"
          />
          <view class="wall-title-actions">
            <text class="muted wall-cancel" bindtap="onCancelWallTitle">取消</text>
            <text class="save-btn" bindtap="onSaveWallTitle">保存</text>
          </view>
        </block>
        <block wx:else>
          <view class="wall-title-tap" bindtap="onEditWallTitle" hover-class="cell-hover">
            <text>{{photoWallTitle}}</text>
            <text class="wall-edit-chip" hover-class="cell-hover">✎</text>
          </view>
        </block>
        <text wx:if="{{photos.length}}" class="muted photo-count">{{photos.length}}/{{photoMax}}</text>
      </view>

      <!-- 封面：设了封面后顶部整幅展示（长按可取消封面） -->
      <view wx:if="{{cover}}" class="cover-wrap" bindlongpress="onCoverMenu" hover-class="cell-hover">
        <image class="cover-img" src="{{coverUrl}}" mode="aspectFill" bindtap="onPreviewCover"/>
        <view class="cover-tag">🌟 封面 · 长按可取消</view>
      </view>

      <!-- 空态：居中大占位，点击上传第一张 -->
      <view wx:if="{{!photos.length}}" class="photo-empty" bindtap="onPickPhotos" hover-class="cell-hover">
        <view class="empty-emoji">📸</view>
        <view class="empty-tip">上传第一张，定格我们的美好时光</view>
      </view>

      <!-- 有照片：网格展示（封面已在顶部大图展示，小格子不再重复显示） -->
      <view wx:elif="{{photos.length}}" class="photo-grid">
        <view
          class="photo-cell"
          wx:for="{{gridPhotos}}"
          wx:key="fileID"
          data-index="{{item.index}}"
          bindtap="onPreviewPhoto"
          bindlongpress="onPhotoMenu"
          hover-class="cell-hover"
        >
          <image class="photo-img" src="{{item.url}}" mode="aspectFill" lazy-load/>
        </view>
      </view>

      <!-- 有照片时：底部美观的添加入口 -->
      <view wx:if="{{photos.length && photos.length < photoMax}}" class="photo-add-btn" bindtap="onPickPhotos" hover-class="cell-hover">
        <text class="add-btn-plus">＋</text>
        <text class="add-btn-text">添加照片</text>
      </view>
    </view>

    <!-- 悄悄话：给对方留一句话 -->
    <view class="card">
      <view class="card-title">
        <text class="card-title-icon">💌</text>
        <text>悄悄话</text>
        <text wx:if="{{!editingNote}}" class="nick-hint" bindtap="onEditNote" hover-class="cell-hover">写一句</text>
      </view>
      <view wx:if="{{!editingNote}}">
        <view wx:if="{{note}}" class="note-bubble">{{note.text}}</view>
        <view wx:if="{{note}}" class="note-meta muted">—— {{note.nick}}</view>
        <view wx:else class="note-empty" bindtap="onEditNote" hover-class="cell-hover">还没有留言，给对方写一句悄悄话吧 ✍️</view>
      </view>
      <view wx:else class="member-edit-row">
        <input
          class="nick-input"
          value="{{noteInput}}"
          focus
          maxlength="100"
          bindinput="onNoteInput"
          bindconfirm="onSaveNote"
          placeholder="把想说的话写在这里…"
        />
        <view class="nick-actions">
          <view class="copy-btn" bindtap="onCancelNote">取消</view>
          <view class="save-btn" bindtap="onSaveNote">发送</view>
        </view>
      </view>
    </view>

    <!-- 邀请码卡：家庭两名成员齐了就不再显示，无意义 -->
    <view wx:if="{{members.length < 2}}" class="card invite-card">
      <view class="card-title">
        <text class="card-title-icon">✉️</text>
        <text>邀请另一半</text>
      </view>
      <view class="row" bindtap="copyCode">
        <view class="muted">邀请码</view>
        <view class="code-val">
          <text class="code">{{family.inviteCode}}</text>
          <view class="copy-btn">复制</view>
        </view>
      </view>
      <view wx:if="{{members.length < 2}}" class="muted tip">
        把上面的邀请码发给 TA 吧
      </view>
    </view>

    <!-- 家庭成员卡 -->
    <view class="card">
      <view class="card-title">
        <text class="card-title-icon">👥</text>
        <text>家庭成员（{{members.length}}/2）</text>
        <text wx:if="{{!editingNick}}" class="nick-hint">点自己可改名</text>
      </view>
      <view class="members">
        <view
          wx:for="{{members}}"
          wx:key="openid"
          class="member {{item.me ? 'me-row' : ''}}"
          data-me="{{item.me}}"
          bindtap="onMemberTap"
          hover-class="member-hover"
        >
          <view class="avatar {{item.me ? 'mine' : ''}}">{{item.nick ? item.nick[0] : '我'}}</view>
          <view class="m-name">{{item.nick}}</view>
          <view class="member-meta">
            <view wx:if="{{item.me}}" class="me-tag">我</view>
            <view wx:if="{{item.me && !editingNick}}" class="me-edit-chip">✏️</view>
          </view>
        </view>
        <view wx:if="{{members.length < 2 && !editingNick}}" class="member empty-slot">
          <view class="avatar ghost">+</view>
          <view class="m-name muted">等待另一半加入…</view>
        </view>
      </view>
      <!-- 点击自己后在成员卡内展开编辑 -->
      <view wx:if="{{editingNick}}" class="member-edit-row">
        <input
          class="nick-input"
          value="{{nickInput}}"
          focus
          maxlength="20"
          bindinput="onNickInput"
          bindconfirm="onSaveNick"
          placeholder="输入新昵称"
        />
        <view class="nick-actions">
          <view class="copy-btn" bindtap="onCancelNick">取消</view>
          <view class="save-btn" bindtap="onSaveNick">保存</view>
        </view>
      </view>
    </view>

    <!-- 使用说明入口 -->
    <view class="card help-entry" hover-class="help-hover" bindtap="goGuide">
      <view class="help-left">
        <text class="card-title-icon">📖</text>
        <text class="help-label">使用说明</text>
      </view>
      <view class="help-right">
        <text class="muted">教 TA 怎么一起用</text>
        <text class="chev-plus">›</text>
      </view>
    </view>

    <!-- 意见反馈入口 -->
    <view class="card help-entry" hover-class="help-hover" bindtap="onFeedbackToggle">
      <view class="help-left">
        <text class="card-title-icon">💬</text>
        <text class="help-label">意见反馈</text>
      </view>
      <view class="help-right">
        <text class="muted">{{showFeedback ? '收起' : '告诉我们你的想法'}}</text>
        <text class="chev-plus">›</text>
      </view>
    </view>

    <!-- 反馈填写面板 -->
    <view wx:if="{{showFeedback}}" class="card feedback-box">
      <textarea
        class="feedback-input"
        value="{{feedbackInput}}"
        maxlength="{{feedbackMax}}"
        auto-height
        placeholder="遇到问题？想要的功能？尽管说～"
        placeholder-class="feedback-ph"
        bindinput="onFeedbackInput"
      />
      <view class="feedback-meta muted">{{feedbackInput.length}}/{{feedbackMax}}</view>
      <view class="feedback-actions">
        <view class="copy-btn" bindtap="onFeedbackCancel">取消</view>
        <view class="save-btn" bindtap="onFeedbackSubmit">提交</view>
      </view>
    </view>

    <!-- 反馈管理入口（仅开发账户可见、可查看全量反馈） -->
    <view wx:if="{{myOpenid && myOpenid === adminOpenid}}" class="card help-entry" hover-class="help-hover" bindtap="onFeedbackManage">
      <view class="help-left">
        <text class="card-title-icon">📋</text>
        <text class="help-label">查看反馈</text>
      </view>
      <view class="help-right">
        <text wx:if="{{feedbackUnread > 0}}" class="fb-badge">{{feedbackUnread}}条新</text>
        <text class="muted">家人提交的反馈</text>
        <text class="chev-plus">›</text>
      </view>
    </view>

    <!-- 反馈列表 -->
    <view wx:if="{{showFeedbackList}}" class="card feedback-list-box">
      <view wx:if="{{feedbackLoading}}" class="fb-loading muted">加载中…</view>
      <view wx:elif="{{!feedbacks.length}}" class="fb-empty muted">还没有反馈，去首页评论区逛逛吧～</view>
      <view
        wx:for="{{feedbacks}}"
        wx:key="id"
        class="fb-item {{item.read ? '' : 'fb-unread'}}"
        bindtap="onFeedbackItemRead"
        data-id="{{item.id}}"
      >
        <view class="fb-item-head">
          <text class="fb-nick">{{item.nick}}</text>
          <text class="fb-time muted">{{item.timeText}}</text>
          <text wx:if="{{!item.read}}" class="fb-dot">●</text>
        </view>
        <view class="fb-content">{{item.content}}</view>
      </view>
    </view>

    <!-- 退出 -->
    <view class="card action-card">
      <button class="leave-btn" bindtap="onLeave">退出家庭</button>
    </view>

    <!-- 版本信息 -->
    <view class="version-foot muted">wesync共享笔记 v{{version}}</view>
  </block>

  <!-- 手动刷新悬浮按钮（家庭成员拉取最新数据） -->
  <view wx:if="{{family}}" class="refresh-fab" bindtap="onRefresh" hover-class="refresh-fab-hover">
    <text class="refresh-spark">✨</text>
    <text class="refresh-icon">🍀</text>
    <text class="refresh-label">刷新</text>
  </view>
</view>