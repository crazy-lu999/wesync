<!--pages/me/me.wxml-->
<view class="page">

  <!-- 首屏 loading 骨架 -->
  <block wx:if="{{loading}}">
    <view class="card skeleton-card">
      <view class="skeleton avatar-sk"></view>
      <view class="skeleton-lines">
        <view class="skeleton-line w55"></view>
        <view class="skeleton-line w75"></view>
        <view class="skeleton-line w40"></view>
      </view>
    </view>
    <view class="card skeleton-card">
      <view class="skeleton-line w70"></view>
      <view class="skeleton-line w85"></view>
    </view>
  </block>

  <block wx:elif="{{family}}">
    <!-- 相片墙卡：自定义上传照片展示（长按删除 / 点按查看） -->
    <view class="card">
      <view class="card-title">
        <text class="card-title-icon">📷</text>
        <block wx:if="{{editingWallTitle}}">
          <input
            class="wall-title-input"
            value="{{wallTitleInput}}"
            focus
            maxlength="12"
            bindinput="onWallTitleInput"
            bindconfirm="onSaveWallTitle"
            placeholder="给相片墙起个名"
          />
          <view class="wall-title-actions">
            <text class="muted wall-cancel" bindtap="onCancelWallTitle">取消</text>
            <text class="save-btn" bindtap="onSaveWallTitle">保存</text>
          </view>
        </block>
        <block wx:else>
          <view class="wall-title-tap" bindtap="onEditWallTitle" hover-class="cell-hover">
            <text>{{photoWallTitle}}</text>
            <text class="wall-edit-chip" hover-class="cell-hover">✎</text>
          </view>
        </block>
        <text wx:if="{{photos.length}}" class="muted photo-count">{{photos.length}}/{{photoMax}}</text>
      </view>

      <!-- 空态：居中大占位，点击上传第一张 -->
      <view wx:if="{{!photos.length}}" class="photo-empty" bindtap="onPickPhotos" hover-class="cell-hover">
        <view class="empty-emoji">📸</view>
        <view class="empty-tip">上传第一张，定格我们的美好时光</view>
      </view>

      <!-- 有照片：网格展示全部照片 -->
      <view wx:elif="{{photos.length}}" class="photo-grid">
        <view
          class="photo-cell"
          wx:for="{{gridPhotos}}"
          wx:key="fileID"
          data-fileid="{{item.fileID}}"
          bindtap="onPreviewPhoto"
          bindlongpress="onPhotoMenu"
          hover-class="cell-hover"
        >
          <image
            class="photo-img"
            src="{{item.url}}"
            mode="aspectFill"
            lazy-load
            data-fileid="{{item.fileID}}"
            binderror="onPhotoError"
          />
        </view>
      </view>

      <!-- 有照片时：底部美观的添加入口 -->
      <view wx:if="{{photos.length && photos.length < photoMax}}" class="photo-add-btn" bindtap="onPickPhotos" hover-class="cell-hover">
        <text class="add-btn-plus">＋</text>
        <text class="add-btn-text">添加照片</text>
      </view>
    </view>

    <!-- 纪念日：可加多个，每个带标题，首页倒计时 → 点卡片长期按可删 -->
    <view class="card">
      <view class="card-title">
        <text class="card-title-icon">💗</text>
        <text>我们的纪念日</text>
        <text wx:if="{{!editingAnniv}}" class="nick-hint" bindtap="onAddAnniv">＋ 添加</text>
      </view>
      <!-- 列表 -->
      <block wx:if="{{!editingAnniv}}">
        <view wx:if="{{!annivs.length}}" class="note-empty" bindtap="onAddAnniv" hover-class="cell-hover">还没记录，点这里记下 TA 的好日子 🗓️</view>
        <view wx:else class="anniv-list">
          <view
            wx:for="{{annivs}}"
            wx:key="id"
            class="anniv-item tone-{{index % 4}}"
            data-id="{{item.id}}"
            bindtap="onEditAnniv"
            hover-class="cell-hover"
          >
            <view class="anniv-item-left">
              <view class="anniv-item-title">{{item.title}}</view>
              <view class="anniv-item-date">
                <text class="anniv-date-text">{{item.date}}</text>
                <text wx:if="{{item.countdown === 0}}" class="anniv-count today">就是今天 🎉</text>
                <text wx:elif="{{item.countdown > 0}}" class="anniv-count">还有 {{item.countdown}} 天</text>
              </view>
            </view>
            <view class="anniv-edit-chip">✎</view>
          </view>
        </view>
      </block>
      <!-- 新增/编辑表单 -->
      <view wx:else class="anniv-form">
        <input
          class="nick-input form-title"
          value="{{titleInput}}"
          focus
          maxlength="12"
          placeholder="给纪念日起个名，如：恋爱纪念日"
          bindinput="onTitleInput"
        />
        <picker mode="date" value="{{dateInput}}" start="1900-01-01" end="{{today}}" bindchange="onDatePick" style="width:100%">
          <view class="nick-input picker-display">🗓️ {{dateInput}}</view>
        </picker>
        <view class="anniv-actions">
          <view class="copy-btn" bindtap="onCancelAnniv">取消</view>
          <view wx:if="{{editingAnnivId}}" class="copy-btn del-btn" bindtap="onDelAnniv">删除</view>
          <view class="save-btn" bindtap="onSaveAnniv">保存</view>
        </view>
      </view>
    </view>

    <!-- 邀请码卡：家庭两名成员齐了就不再显示，无意义 -->
    <view wx:if="{{members.length < 2}}" class="card invite-card">
      <view class="card-title">
        <text class="card-title-icon">✉️</text>
        <text>邀请另一半</text>
      </view>
      <view class="row" bindtap="copyCode">
        <view class="muted">邀请码</view>
        <view class="code-val">
          <text class="code">{{family.inviteCode}}</text>
          <view class="copy-btn">复制</view>
        </view>
      </view>
      <button class="btn-primary share-invite" bindtap="copyCode">📋 复制邀请码</button>
      <view wx:if="{{members.length < 2}}" class="muted tip">
        把邀请码给 TA，TA 打开小程序后点「加入家庭」输入即可
      </view>
    </view>

    <!-- 家庭成员卡 -->
    <view class="card">
      <view class="card-title">
        <text class="card-title-icon">👥</text>
        <text>家庭成员（{{members.length}}/2）</text>
        <text wx:if="{{!editingNick}}" class="nick-hint">点名字可改名</text>
      </view>
      <view class="members">
        <view
          wx:for="{{members}}"
          wx:key="openid"
          class="member {{item.me ? 'me-row' : ''}}"
          data-me="{{item.me}}"
          bindtap="onMemberTap"
          hover-class="member-hover"
        >
          <!-- 头像：首字母圆标（我=珊瑚橙、TA=葆粉，一眼分得清） -->
          <view class="avatar {{item.me ? 'avatar-me' : 'avatar-ta'}}">
            <text class="avatar-letter">{{item.nick ? item.nick[0] : '我'}}</text>
          </view>
          <view class="m-name">{{item.nick}}</view>
          <view class="member-meta">
            <view wx:if="{{item.me}}" class="me-tag">我</view>
            <view wx:if="{{item.me && !editingNick}}" class="me-edit-chip">✏️</view>
          </view>
        </view>
        <view wx:if="{{members.length < 2 && !editingNick}}" class="member empty-slot">
          <view class="avatar ghost">+</view>
          <view class="m-name muted">等待另一半加入…</view>
        </view>
      </view>
      <!-- 点击自己后在成员卡内展开编辑 -->
      <view wx:if="{{editingNick}}" class="member-edit-row">
        <input
          class="nick-input"
          value="{{nickInput}}"
          focus
          maxlength="20"
          bindinput="onNickInput"
          bindconfirm="onSaveNick"
          placeholder="输入新昵称"
        />
        <view class="nick-actions">
          <view class="copy-btn" bindtap="onCancelNick">取消</view>
          <view class="save-btn" bindtap="onSaveNick">保存</view>
        </view>
      </view>
    </view>

    <!-- 开启微信提醒入口 -->
    <view class="card help-entry" hover-class="help-hover" bindtap="onEnableRemind">
      <view class="help-left">
        <text class="card-title-icon">🔔</text>
        <text class="help-label">开启微信提醒</text>
      </view>
      <view class="help-right">
        <text class="muted">点一下授权，记得勾「总是」</text>
        <text class="chev-plus">›</text>
      </view>
    </view>

    <!-- 使用说明入口 -->
    <view class="card help-entry" hover-class="help-hover" bindtap="goGuide">
      <view class="help-left">
        <text class="card-title-icon">📖</text>
        <text class="help-label">使用说明</text>
      </view>
      <view class="help-right">
        <text class="muted">教 TA 怎么一起用</text>
        <text class="chev-plus">›</text>
      </view>
    </view>

    <!-- 更新日志入口 -->
    <view class="card help-entry" hover-class="help-hover" bindtap="goReleaseNotes">
      <view class="help-left">
        <text class="card-title-icon">🗒️</text>
        <text class="help-label">更新日志</text>
      </view>
      <view class="help-right">
        <text class="muted">看看最近更新了什么</text>
        <text class="chev-plus">›</text>
      </view>
    </view>

    <!-- 意见反馈入口（私密，仅开发者可见） -->
    <view class="card help-entry" hover-class="help-hover" bindtap="goFeedback">
      <view class="help-left">
        <text class="card-title-icon">💬</text>
        <text class="help-label">意见反馈</text>
      </view>
      <view class="help-right">
        <text class="muted">告诉我们你的想法</text>
        <text class="chev-plus">›</text>
      </view>
    </view>

    <!-- 反馈管理入口（仅开发者本人可见） -->
    <view wx:if="{{isAdmin}}" class="card help-entry" hover-class="help-hover" bindtap="goAdminFeedback">
      <view class="help-left">
        <text class="card-title-icon">🛠️</text>
        <text class="help-label">反馈管理</text>
      </view>
      <view class="help-right">
        <text class="muted">仅你可见 · 查看用户反馈</text>
        <text class="chev-plus">›</text>
      </view>
    </view>

    <!-- 退出 -->
    <view class="card action-card">
      <button class="leave-btn" bindtap="onLeave">退出家庭</button>
    </view>

    <!-- 版本信息 -->
    <view class="version-foot muted">wesync共享笔记 v{{version}}</view>
  </block>

  <!-- 手动刷新悬浮按钮（家庭成员拉取最新数据） -->
  <view wx:if="{{family}}" class="refresh-fab" bindtap="onRefresh" hover-class="refresh-fab-hover">
    <text class="refresh-spark">✨</text>
    <text class="refresh-icon">🍀</text>
    <text class="refresh-label">刷新</text>
  </view>
</view>