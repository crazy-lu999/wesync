/* pages/me/me.wxss */
.page { padding-top: 40rpx; }

/* 家庭名牌卡 */
.profile {
  display: flex; align-items: center; gap: 24rpx;
  background: linear-gradient(135deg, #FF6F5E 0%, #FFA07F 100%) !important;
  border: none !important; box-shadow: 0 16rpx 40rpx rgba(255, 111, 94, 0.35) !important;
}
.profile-icon {
  width: 108rpx; height: 108rpx; border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.22);
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx;
}
.profile-info { display: flex; flex-direction: column; }
.profile-name { font-size: 42rpx; font-weight: 800; color: #fff; letter-spacing: 1rpx; }
.profile-sub { font-size: 26rpx; color: rgba(255, 255, 255, 0.85); margin-top: 8rpx; }

/* 卡片标题 */
.card-title {
  display: flex; align-items: center; gap: 12rpx;
  font-size: 30rpx; font-weight: 700; color: #2A2626; margin-bottom: 20rpx;
}
.card-title-icon { font-size: 30rpx; }

/* 邀请码 */
.invite-card .row {
  display: flex; align-items: center; justify-content: space-between;
}
.code-val { display: flex; align-items: center; gap: 20rpx; }
.code {
  font-size: 48rpx; font-weight: 800; color: #FF6F5E; letter-spacing: 10rpx;
  font-family: "SF Mono", Menlo, monospace; text-indent: 10rpx;
}
.copy-btn {
  background: #FFEFEA; color: #FF6F5E; font-size: 24rpx; font-weight: 600;
  padding: 10rpx 24rpx; border-radius: 999rpx;
}

/* 我的昵称 */
.nick-row {
  display: flex; align-items: center; justify-content: space-between;
  min-height: 84rpx;
}
.nick-row-hover { opacity: 0.72; }
.nick-view { display: flex; align-items: center; gap: 22rpx; }
.nick-avatar { width: 72rpx; height: 72rpx; font-size: 30rpx; }
.nick-name { font-size: 30rpx; font-weight: 600; color: #2A2626; }
.nick-hint {
  margin-left: auto; font-size: 22rpx; color: #B8B2AF; font-weight: 400;
}
.nick-edit {
  width: 60rpx; height: 60rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: #FFF1EC; font-size: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 111, 94, 0.2);
}
.nick-input {
  flex: 1; padding: 0 24rpx; height: 76rpx; line-height: 76rpx;
  background: #F7F5F4; border: 2rpx solid #E8E3E0; border-radius: 16rpx;
  font-size: 30rpx;
}
.nick-actions { display: flex; align-items: center; gap: 16rpx; margin-left: 20rpx; }
.save-btn {
  background: #FF6F5E; color: #fff; font-size: 24rpx; font-weight: 600;
  padding: 10rpx 26rpx; border-radius: 999rpx;
}

/* 成员 */
.members { display: flex; flex-direction: column; gap: 28rpx; padding-top: 4rpx; }
.member { display: flex; align-items: center; gap: 22rpx; }
.avatar {
  width: 84rpx; height: 84rpx; border-radius: 50%;
  background: linear-gradient(135deg, #c9bfb8, #a99f99);
  color: #fff; font-size: 36rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(80, 60, 50, 0.16);
}
.avatar.mine {
  background: linear-gradient(135deg, #FF6F5E, #FF917A);
  box-shadow: 0 8rpx 18rpx rgba(255, 111, 94, 0.32);
}
.avatar.ghost {
  background: #F4F2F1; color: #C4BFBC; font-size: 48rpx; font-weight: 400;
  box-shadow: none; border: 2rpx dashed #DDD8D5;
}
.m-name { font-size: 32rpx; font-weight: 600; }
.me-tag {
  background: #FFEFEA; color: #FF6F5E; font-size: 22rpx; font-weight: 600;
  padding: 6rpx 18rpx; border-radius: 999rpx;
}
.tip { font-size: 24rpx; margin-top: 20rpx; color: #B8B2AF; }

/* 我的提醒 */
.reminder-list { display: flex; flex-direction: column; }
.reminder-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 0; border-top: 1rpx solid #F3EFED;
}
.reminder-item:first-child { border-top: none; padding-top: 4rpx; }
.reminder-main { flex: 1; min-width: 0; margin-right: 20rpx; }
.reminder-content {
  font-size: 30rpx; font-weight: 600; color: #2A2626;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.reminder-meta {
  margin-top: 10rpx; display: flex; align-items: center; gap: 16rpx;
  font-size: 24rpx;
}
.reminder-time { color: #FF6F5E; font-weight: 600; }
.reminder-remain { color: #B8B2AF; }
.reminder-cancel {
  flex: none; color: #FF6F5E; font-size: 24rpx; font-weight: 600;
  background: #FFF1EC; padding: 12rpx 24rpx; border-radius: 999rpx;
}

/* 退出 */
.action-card { padding: 24rpx; }
.leave-btn {
  background: #fff; color: #F0413B; border: 2rpx solid #FFD7D3;
  border-radius: 48rpx; font-size: 30rpx; font-weight: 600; width: 100%; height: 92rpx;
  line-height: 92rpx;
}
.leave-btn::after { border: none; }

/* 首屏 loading 骨架 */
.skeleton-card { display: flex; align-items: center; gap: 24rpx; }
.skeleton-lines { flex: 1; display: flex; flex-direction: column; gap: 20rpx; }
.skeleton.avatar-sk {
  width: 96rpx; height: 96rpx; border-radius: 28rpx; margin: 0;
}
.skeleton-line {
  height: 30rpx; border-radius: 8rpx;
  background: linear-gradient(90deg, #f0ecea 25%, #e5dfdc 37%, #f0ecea 63%);
  background-size: 400% 100%;
  animation: shimmer 1.2s infinite;
}
.w40 { width: 40%; } .w55 { width: 55%; } .w70 { width: 70%; }
.w75 { width: 75%; } .w85 { width: 85%; }
@keyframes shimmer { 0% { background-position: 100% 0; } 100% { background-position: -100% 0; } }