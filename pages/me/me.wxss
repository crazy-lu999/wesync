/* pages/me/me.wxss */
.page { padding-top: 40rpx; }

/* 相片墙标题：点击可改名 */
.wall-title-tap {
  display: flex; align-items: center; gap: 10rpx;
  padding-right: 8rpx; cursor: pointer;
}
.wall-edit-chip {
  font-size: 22rpx; color: #FF9A86;
  background: #FFF1EC; border-radius: 999rpx;
  padding: 4rpx 12rpx; margin-left: 4rpx;
}
.wall-title-input {
  flex: 1; min-width: 120rpx; height: 56rpx; line-height: 56rpx;
  padding: 0 18rpx; margin-right: 12rpx;
  background: #F7F5F4; border: 2rpx solid #FFD7CE; border-radius: 12rpx;
  font-size: 28rpx; font-weight: 600; color: #2A2626;
}
.wall-title-actions {
  margin-left: auto; display: flex; align-items: center; gap: 16rpx;
}
.wall-cancel {
  font-size: 24rpx; font-weight: 600;
  padding: 8rpx 6rpx; cursor: pointer;
}

/* 相片墙 */
.photo-count { margin-left: auto; font-size: 22rpx; font-weight: 400; }
.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}
.photo-cell {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
  background: #F4F2F1;
}
.photo-img {
  width: 100%; height: 100%; display: block;
}
.cell-hover { opacity: 0.78; }

/* 封面 */
.cover-wrap {
  position: relative; width: 100%; height: 300rpx;
  border-radius: 20rpx; overflow: hidden; margin-bottom: 16rpx;
}
.cover-img { width: 100%; height: 100%; display: block; }
.cover-tag {
  position: absolute; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45); color: #fff; font-size: 22rpx;
  padding: 8rpx 22rpx; border-radius: 20rpx 0 20rpx 0;
}
.photo-cell.covered {
  box-shadow: 0 0 0 4rpx #FF6F5E;
}
.cell-cover-mark {
  position: absolute; left: 0; top: 0;
  background: #FF6F5E; color: #fff; font-size: 20rpx;
  padding: 4rpx 14rpx; border-radius: 16rpx 0 16rpx 0;
}

/* 相片墙空态 */
.photo-empty {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 20rpx;
  padding: 56rpx 0;
  background: #FBF9F8;
  border: 2rpx dashed #E4DEDA;
  border-radius: 20rpx;
  cursor: pointer;
}
.empty-emoji { font-size: 64rpx; line-height: 1; }
.empty-tip { font-size: 26rpx; color: #B8B2AF; }

/* 相片墙有照片时的底部添加入口 */
.photo-add-btn {
  margin-top: 20rpx;
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  height: 72rpx;
  background: #FFF3F0;
  border: 2rpx solid #FFE0D8;
  border-radius: 999rpx;
  color: #FF6F5E;
  cursor: pointer;
}
.add-btn-plus { font-size: 34rpx; line-height: 1; font-weight: 600; }
.add-btn-text { font-size: 28rpx; font-weight: 600; }

/* 家庭名牌卡 */
.profile {
  display: flex; align-items: center; gap: 24rpx;
  background: linear-gradient(135deg, #FF6F5E 0%, #FFA07F 100%) !important;
  border: none !important; box-shadow: 0 16rpx 40rpx rgba(255, 111, 94, 0.35) !important;
}
.profile-icon {
  width: 108rpx; height: 108rpx; border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.22);
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx;
}
.profile-info { display: flex; flex-direction: column; }
.profile-name { font-size: 42rpx; font-weight: 800; color: #fff; letter-spacing: 1rpx; }
.profile-sub { font-size: 26rpx; color: rgba(255, 255, 255, 0.85); margin-top: 8rpx; }

/* 卡片标题 */
.card-title {
  display: flex; align-items: center; gap: 12rpx;
  font-size: 30rpx; font-weight: 700; color: #2A2626; margin-bottom: 20rpx;
}
.card-title-icon { font-size: 30rpx; }

/* 邀请码 */
.invite-card .row {
  display: flex; align-items: center; justify-content: space-between;
}
.code-val { display: flex; align-items: center; gap: 20rpx; }
.code {
  font-size: 48rpx; font-weight: 800; color: #FF6F5E; letter-spacing: 10rpx;
  font-family: "SF Mono", Menlo, monospace; text-indent: 10rpx;
}
.copy-btn {
  background: #FFEFEA; color: #FF6F5E; font-size: 24rpx; font-weight: 600;
  padding: 10rpx 24rpx; border-radius: 999rpx;
}

/* 成员卡内改名 */
.nick-hint {
  margin-left: auto; font-size: 22rpx; color: #B8B2AF; font-weight: 400;
}
.me-edit-chip {
  width: 60rpx; height: 60rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: #FFF1EC; font-size: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 111, 94, 0.2);
}
.member-meta { display: flex; align-items: center; gap: 16rpx; margin-left: auto; }
.member-hover { opacity: 0.72; }
.member-edit-row {
  margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid #F3EFED;
  display: flex; align-items: center;
}
.nick-input {
  flex: 1; padding: 0 24rpx; height: 76rpx; line-height: 76rpx;
  background: #F7F5F4; border: 2rpx solid #E8E3E0; border-radius: 16rpx;
  font-size: 30rpx;
}
.nick-actions { display: flex; align-items: center; gap: 16rpx; margin-left: 20rpx; }
.save-btn {
  background: #FF6F5E; color: #fff; font-size: 24rpx; font-weight: 600;
  padding: 10rpx 26rpx; border-radius: 999rpx;
}

/* 成员 */
.members { display: flex; flex-direction: column; gap: 28rpx; padding-top: 4rpx; }
.member { display: flex; align-items: center; gap: 22rpx; }
.avatar {
  width: 84rpx; height: 84rpx; border-radius: 50%;
  background: linear-gradient(135deg, #c9bfb8, #a99f99);
  color: #fff; font-size: 36rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(80, 60, 50, 0.16);
}
.avatar.mine {
  background: linear-gradient(135deg, #FF6F5E, #FF917A);
  box-shadow: 0 8rpx 18rpx rgba(255, 111, 94, 0.32);
}
.avatar.ghost {
  background: #F4F2F1; color: #C4BFBC; font-size: 48rpx; font-weight: 400;
  box-shadow: none; border: 2rpx dashed #DDD8D5;
}
.m-name { font-size: 32rpx; font-weight: 600; }
.me-tag {
  background: #FFEFEA; color: #FF6F5E; font-size: 22rpx; font-weight: 600;
  padding: 6rpx 18rpx; border-radius: 999rpx;
}
.tip { font-size: 24rpx; margin-top: 20rpx; color: #B8B2AF; }

/* 使用说明入口 */
.help-entry {
  display: flex; align-items: center; justify-content: space-between;
  padding: 32rpx 36rpx;
}
.help-hover { background: #FDF9F8; }
.help-left { display: flex; align-items: center; gap: 16rpx; }
.help-label { font-size: 30rpx; font-weight: 700; color: #2A2626; }
.help-right { display: flex; align-items: center; gap: 12rpx; }
.chev-plus { color: #C4BFBC; font-size: 36rpx; }

/* 意见反馈 */
.feedback-box { margin-top: -8rpx; }
.feedback-input {
  width: 100%; min-height: 200rpx;
  padding: 24rpx; box-sizing: border-box;
  background: #F7F5F4; border: 2rpx solid transparent; border-radius: 20rpx;
  font-size: 30rpx; line-height: 1.6; color: #2A2626;
}
.feedback-input:focus { border-color: rgba(255, 111, 94, 0.4); }
.feedback-ph { color: #C4BFBC; }
.feedback-meta { margin-top: 12rpx; text-align: right; font-size: 22rpx; }
.feedback-actions {
  display: flex; justify-content: flex-end; align-items: center; gap: 20rpx;
  margin-top: 20rpx;
}

/* 版本信息 */
.version-foot { text-align: center; margin: 36rpx 0 60rpx; }

/* 退出 */
.action-card { padding: 24rpx; }
.leave-btn {
  background: #fff; color: #F0413B; border: 2rpx solid #FFD7D3;
  border-radius: 48rpx; font-size: 30rpx; font-weight: 600; width: 100%; height: 92rpx;
  display: flex; align-items: center; justify-content: center;
  box-sizing: border-box; line-height: 1; padding: 0;
}
.leave-btn::after { border: none; }

/* 首屏 loading 骨架 */
.skeleton-card { display: flex; align-items: center; gap: 24rpx; }
.skeleton-lines { flex: 1; display: flex; flex-direction: column; gap: 20rpx; }
.skeleton.avatar-sk {
  width: 96rpx; height: 96rpx; border-radius: 28rpx; margin: 0;
}
.skeleton-line {
  height: 30rpx; border-radius: 8rpx;
  background: linear-gradient(90deg, #f0ecea 25%, #e5dfdc 37%, #f0ecea 63%);
  background-size: 400% 100%;
  animation: shimmer 1.2s infinite;
}
.w40 { width: 40%; } .w55 { width: 55%; } .w70 { width: 70%; }
.w75 { width: 75%; } .w85 { width: 85%; }
@keyframes shimmer { 0% { background-position: 100% 0; } 100% { background-position: -100% 0; } }