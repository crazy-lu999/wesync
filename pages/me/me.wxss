/* pages/me/me.wxss */
.page { padding-top: 40rpx; padding-bottom: 220rpx; }

/* 相片墙标题：点击可改名 */
.wall-title-tap {
  display: flex; align-items: center; gap: 10rpx;
  padding-right: 8rpx; cursor: pointer;
}
.wall-edit-chip {
  font-size: 22rpx; color: #FF9A86;
  background: #FFF1EC; border-radius: 999rpx;
  padding: 4rpx 12rpx; margin-left: 4rpx;
}
.wall-title-input {
  flex: 1; min-width: 120rpx; height: 56rpx; line-height: 56rpx;
  padding: 0 18rpx; margin-right: 12rpx;
  background: #F7F5F4; border: 2rpx solid #FFD7CE; border-radius: 12rpx;
  font-size: 28rpx; font-weight: 600; color: #2A2626;
}
.wall-title-actions {
  margin-left: auto; display: flex; align-items: center; gap: 16rpx;
}
.wall-cancel {
  font-size: 24rpx; font-weight: 600;
  padding: 8rpx 6rpx; cursor: pointer;
}

/* 相片墙 */
.photo-count { margin-left: auto; font-size: 22rpx; font-weight: 400; }
.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}
.photo-cell {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
  background: #F4F2F1;
}
.photo-img {
  width: 100%; height: 100%; display: block;
}
.cell-hover { opacity: 0.78; }

/* 相片墙空态 */
.photo-empty {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 20rpx;
  padding: 56rpx 0;
  background: #FBF9F8;
  border: 2rpx dashed #E4DEDA;
  border-radius: 20rpx;
  cursor: pointer;
}
.empty-emoji { font-size: 64rpx; line-height: 1; }
.empty-tip { font-size: 26rpx; color: #B8B2AF; }

/* 相片墙有照片时的底部添加入口 */
.photo-add-btn {
  margin-top: 20rpx;
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  height: 72rpx;
  background: #FFF3F0;
  border: 2rpx solid #FFE0D8;
  border-radius: 999rpx;
  color: #FF6F5E;
  cursor: pointer;
}
.add-btn-plus { font-size: 34rpx; line-height: 1; font-weight: 600; }
.add-btn-text { font-size: 28rpx; font-weight: 600; }

/* 纪念日空态 / 占位提示（通用） */
.note-empty {
  padding: 28rpx 0; text-align: center;
  font-size: 26rpx; color: #C09C93;
  background: #FFF8F5;
  border: 1rpx dashed #FFE0D4;
  border-radius: 18rpx; margin-top: 8rpx;
}

/* 纪念日卡：柔和彩色渐变 + 左侧色条（多档色系轮换，不再是黑白） */
.anniv-list { display: flex; flex-direction: column; gap: 16rpx; }
.anniv-item {
  position: relative;
  display: flex; align-items: center; justify-content: space-between;
  padding: 22rpx 26rpx 22rpx 30rpx;
  background: linear-gradient(135deg, #FFF3EE 0%, #FFE7DE 100%);
  border: 1rpx solid rgba(255, 111, 94, 0.16);
  border-radius: 18rpx;
  box-shadow: 0 6rpx 18rpx rgba(255, 122, 89, 0.08);
  overflow: hidden;
}
/* 左侧彩色小竖条：白卡里一眼就能认出「彩色那一块」 */
.anniv-item::before {
  content: ''; position: absolute; left: 0; top: 16rpx; bottom: 16rpx;
  width: 6rpx; border-radius: 0 6rpx 6rpx 0;
  background: linear-gradient(180deg, #FFB199, #FF6F5E);
}
/* 多个纪念日按 index % 4 轮换色系，不会一片同色 */
.anniv-item.tone-1 {
  background: linear-gradient(135deg, #FFF1F7 0%, #FFE2EF 100%);
  border-color: rgba(238, 111, 168, 0.18);
  box-shadow: 0 6rpx 18rpx rgba(238, 111, 168, 0.08);
}
.anniv-item.tone-1::before { background: linear-gradient(180deg, #FFB3D1, #EE6FA8); }
.anniv-item.tone-2 {
  background: linear-gradient(135deg, #F4F1FF 0%, #E9E3FF 100%);
  border-color: rgba(139, 124, 246, 0.18);
  box-shadow: 0 6rpx 18rpx rgba(139, 124, 246, 0.08);
}
.anniv-item.tone-2::before { background: linear-gradient(180deg, #B9AEFF, #8B7CF6); }
.anniv-item.tone-3 {
  background: linear-gradient(135deg, #EDF8F3 0%, #DEF2E8 100%);
  border-color: rgba(63, 178, 133, 0.18);
  box-shadow: 0 6rpx 18rpx rgba(63, 178, 133, 0.08);
}
.anniv-item.tone-3::before { background: linear-gradient(180deg, #8FD9BC, #46B98A); }

.anniv-item-left { min-width: 0; flex: 1; }
.anniv-item-title { font-size: 30rpx; font-weight: 700; color: #3A3533; word-break: break-all; }
.anniv-item-date {
  margin-top: 8rpx; font-size: 23rpx; color: #8B827E;
  display: flex; align-items: center; gap: 10rpx;
}
.anniv-date-text { font-size: 23rpx; }
/* 「还有 N 天」小胶囊：彩色 + 轻阴影，重点信息一眼看到 */
.anniv-count {
  font-size: 22rpx; font-weight: 700; color: #FF6F5E;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 999rpx; padding: 2rpx 14rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 111, 94, 0.16);
}
.anniv-item.tone-1 .anniv-count { color: #E85D9C; box-shadow: 0 2rpx 8rpx rgba(238, 111, 168, 0.18); }
.anniv-item.tone-2 .anniv-count { color: #8B7CF6; box-shadow: 0 2rpx 8rpx rgba(139, 124, 246, 0.18); }
.anniv-item.tone-3 .anniv-count { color: #2FA97C; box-shadow: 0 2rpx 8rpx rgba(63, 178, 133, 0.18); }
/* 就是今天：渐变实心胶囊，最醒目（写在 tone 之后，覆盖各档色） */
.anniv-item .anniv-count.today {
  color: #fff;
  background: linear-gradient(135deg, #FF8A6E 0%, #FF5C8A 100%);
  box-shadow: 0 4rpx 14rpx rgba(255, 92, 138, 0.34);
}
.anniv-edit-chip {
  flex: none; margin-left: 16rpx;
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: rgba(255, 255, 255, 0.88); color: #FF6F5E;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 111, 94, 0.14);
}
.anniv-form { display: flex; flex-direction: column; gap: 16rpx; }
.anniv-form .form-title { width: 100%; box-sizing: border-box; }
.anniv-actions { display: flex; justify-content: flex-end; align-items: center; gap: 16rpx; }
.del-btn { background: #FFF0EE; color: #F0413B; }
.picker-display {
  display: flex; align-items: center;
  width: 100%; box-sizing: border-box;
}


/* 卡片标题 */
.card-title {
  display: flex; align-items: center; gap: 12rpx;
  font-size: 30rpx; font-weight: 700; color: #2A2626; margin-bottom: 20rpx;
}
.card-title-icon { font-size: 30rpx; }

/* 邀请码 */
.invite-card .row {
  display: flex; align-items: center; justify-content: space-between;
}
.share-invite { margin-top: 20rpx; }
.code-val { display: flex; align-items: center; gap: 20rpx; }
.code {
  font-size: 48rpx; font-weight: 800; color: #FF6F5E; letter-spacing: 10rpx;
  font-family: "SF Mono", Menlo, monospace; text-indent: 10rpx;
}
.copy-btn {
  background: #FFEFEA; color: #FF6F5E; font-size: 24rpx; font-weight: 600;
  padding: 10rpx 24rpx; border-radius: 999rpx;
}

/* 成员卡内改名 */
.nick-hint {
  margin-left: auto; font-size: 22rpx; color: #B8B2AF; font-weight: 400;
}
.me-edit-chip {
  width: 60rpx; height: 60rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: #FFF1EC; font-size: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 111, 94, 0.2);
}
.member-meta { display: flex; align-items: center; gap: 16rpx; margin-left: auto; }
.member-hover { opacity: 0.72; }
.member-edit-row {
  margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid #F3EFED;
  display: flex; align-items: center;
}
.nick-input {
  flex: 1; padding: 0 24rpx; height: 76rpx; line-height: 76rpx;
  background: #F7F5F4; border: 2rpx solid #E8E3E0; border-radius: 16rpx;
  font-size: 30rpx;
}
.nick-actions { display: flex; align-items: center; gap: 16rpx; margin-left: 20rpx; }
.save-btn {
  background: #FF6F5E; color: #fff; font-size: 24rpx; font-weight: 600;
  padding: 10rpx 26rpx; border-radius: 999rpx;
}

/* 成员 */
.members { display: flex; flex-direction: column; gap: 28rpx; padding-top: 4rpx; }
.member { display: flex; align-items: center; gap: 22rpx; position: relative; }
.avatar {
  width: 84rpx; height: 84rpx; border-radius: 50%;
  /* 默认（我）= 珊瑚橙暖渐变；TA 由 .avatar-ta 覆盖：两人一眼分得清 */
  background: linear-gradient(135deg, #FFC3A6 0%, #FF8164 60%, #FF6F5E 100%);
  color: #fff; font-size: 36rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden; position: relative;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(255, 111, 94, 0.3);
  box-sizing: border-box;
  border: 3rpx solid rgba(255, 255, 255, 0.85);
}
/* 左上角 Q 弹高光 */
.avatar::after {
  content: ''; position: absolute; top: 12rpx; left: 16rpx;
  width: 24rpx; height: 14rpx; border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  transform: rotate(-30deg);
}
.avatar-ta {
  background: linear-gradient(135deg, #FFC2DC 0%, #F87FB4 60%, #EE6FA8 100%);
  box-shadow: 0 8rpx 20rpx rgba(238, 111, 168, 0.3);
}
.avatar-letter {
  display: flex; align-items: center; justify-content: center;
  width: 100%; height: 100%;
  position: relative; z-index: 1;
  text-shadow: 0 2rpx 6rpx rgba(150, 50, 30, 0.18);
}
/* 等待另一半加入的空位：暖色虚线占位，不再是死灰 */
.avatar.ghost {
  background: #FFF6F3; color: #FFAE97; font-size: 46rpx; font-weight: 400;
  box-shadow: none; border: 2rpx dashed #FFD3C6;
}
.avatar.ghost::after { display: none; }
.m-name { font-size: 32rpx; font-weight: 600; color: #2A2626; }
.me-tag {
  background: #FFEFEA; color: #FF6F5E; font-size: 22rpx; font-weight: 600;
  padding: 6rpx 18rpx; border-radius: 999rpx;
}
.tip { font-size: 24rpx; margin-top: 20rpx; color: #B8B2AF; }

/* 使用说明入口 */
.help-entry {
  display: flex; align-items: center; justify-content: space-between;
  padding: 32rpx 36rpx;
}
.help-hover { background: #FDF9F8; }
.help-left { display: flex; align-items: center; gap: 16rpx; }
.help-label { font-size: 30rpx; font-weight: 700; color: #2A2626; }
.help-right { display: flex; align-items: center; gap: 12rpx; }
.chev-plus { color: #C4BFBC; font-size: 36rpx; }

/* 版本信息 */
.version-foot { text-align: center; margin: 36rpx 0 60rpx; }

/* 手动刷新悬浮按钮（右下角，可爱圆球） */
/* P0：去掉无意义的 bob 常驻动画与顶部星光一闪，静置低调 */
.refresh-fab {
  position: fixed; right: 30rpx; bottom: 64rpx; z-index: 60;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0rpx;
  width: 108rpx; height: 108rpx; border-radius: 50%;
  background: linear-gradient(135deg, #FFB199, #FF6F5E, #FF917A); color: #fff;
  box-shadow:
    0 12rpx 26rpx rgba(255, 111, 94, 0.42),
    inset 0 4rpx 8rpx rgba(255, 255, 255, 0.4),
    inset 0 -6rpx 12rpx rgba(180, 60, 40, 0.16);
}
/* 左上角高光小圆点，更 Q */
.refresh-fab::after {
  content: ''; position: absolute; top: 16rpx; left: 20rpx;
  width: 22rpx; height: 14rpx; border-radius: 50%;
  background: rgba(255, 255, 255, 0.55);
  transform: rotate(-30deg);
}
/* 右上角小星星：静置点缀，不再常驻闪烁 */
.refresh-spark {
  position: absolute; top: -4rpx; right: 0rpx;
  font-size: 28rpx; line-height: 1;
}
.refresh-icon { font-size: 44rpx; line-height: 1; }
.refresh-label { font-size: 18rpx; font-weight: 600; line-height: 1.2; }
.refresh-fab-hover {
  transform: scale(0.94); opacity: 0.9;
}

/* 退出 */
.action-card { padding: 24rpx; }
.leave-btn {
  background: #fff; color: #F0413B; border: 2rpx solid #FFD7D3;
  border-radius: 48rpx; font-size: 30rpx; font-weight: 600; width: 100%; height: 92rpx;
  display: flex; align-items: center; justify-content: center;
  box-sizing: border-box; line-height: 1; padding: 0;
}
.leave-btn::after { border: none; }

/* 首屏 loading 骨架 */
.skeleton-card { display: flex; align-items: center; gap: 24rpx; }
.skeleton-lines { flex: 1; display: flex; flex-direction: column; gap: 20rpx; }
.skeleton.avatar-sk {
  width: 96rpx; height: 96rpx; border-radius: 28rpx; margin: 0;
}
.skeleton-line {
  height: 30rpx; border-radius: 8rpx;
  background: linear-gradient(90deg, #f0ecea 25%, #e5dfdc 37%, #f0ecea 63%);
  background-size: 400% 100%;
  animation: shimmer 1.2s infinite;
}
.w40 { width: 40%; } .w55 { width: 55%; } .w70 { width: 70%; }
.w75 { width: 75%; } .w85 { width: 85%; }
@keyframes shimmer { 0% { background-position: 100% 0; } 100% { background-position: -100% 0; } }