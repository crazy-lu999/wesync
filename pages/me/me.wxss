/* pages/me/me.wxss */
.page { padding-top: 20rpx; }
.row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 0; border-bottom: 2rpx solid #f5f5f7;
}
.row:last-child { border-bottom: none; }
.val { font-size: 32rpx; font-weight: 600; }
.code-val { display: flex; align-items: center; gap: 16rpx; }
.code { font-size: 40rpx; font-weight: 700; color: #FF7A59; letter-spacing: 8rpx; font-family: monospace; }
.copy-hint { font-size: 24rpx; color: #FF7A59; }

.block-title { font-size: 26rpx; color: #888; margin-bottom: 24rpx; }
.members { display: flex; flex-direction: column; gap: 24rpx; }
.member {
  display: flex; align-items: center; gap: 20rpx;
}
.avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: #FF7A59; color: #fff; font-size: 32rpx;
  display: flex; align-items: center; justify-content: center;
}
.avatar.ghost { background: #f0f0f3; color: #bbb; font-size: 44rpx; }
.m-name { font-size: 30rpx; }
.me-tag {
  background: #ffe7df; color: #FF7A59; font-size: 22rpx;
  padding: 4rpx 16rpx; border-radius: 999rpx;
}
.tip { font-size: 24rpx; margin-top: 24rpx; }

.leave-btn {
  background: #fff; color: #f5222d; border: 2rpx solid #ffd1d6;
  border-radius: 999rpx; font-size: 30rpx; width: 100%;
}
